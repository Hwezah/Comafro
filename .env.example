# All variables are optional. Without the Clerk keys the public site builds and
# runs normally, and /sign-in, /sign-up and /dashboard show a "not configured" notice.

# Clerk — https://dashboard.clerk.com → your app → API keys.
# On Vercel: Project → Settings → Environment Variables, then redeploy.
# Set both keys together, from the same Clerk instance (pk_test_/sk_test_ or pk_live_/sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
